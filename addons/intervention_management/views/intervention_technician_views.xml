<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_technician_tree" model="ir.ui.view">
        <field name="name">intervention.technician.tree</field>
        <field name="model">intervention.technician</field>
        <field name="arch" type="xml">
            <tree string="Techniciens">
                <field name="name"/>
                <field name="speciality"/>
                <field name="phone"/>
                <field name="user_id" optional="show"/>
                <field name="open_intervention_count"/>
            </tree>
        </field>
    </record>

    <record id="view_technician_form" model="ir.ui.view">
        <field name="name">intervention.technician.form</field>
        <field name="model">intervention.technician</field>
        <field name="arch" type="xml">
            <form string="Technicien">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_interventions" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="intervention_count" widget="statinfo" string="Interventions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Nom du technicien"/></h1></div>
                    <group>
                        <group>
                            <field name="speciality"/>
                            <field name="user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_technician" model="ir.actions.act_window">
        <field name="name">Techniciens</field>
        <field name="res_model">intervention.technician</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
