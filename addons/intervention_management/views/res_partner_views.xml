<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_interventions" model="ir.ui.view">
        <field name="name">res.partner.form.interventions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_interventions" type="object" class="oe_stat_button" icon="fa-wrench"
                        groups="intervention_management.group_intervention_technician">
                    <field name="intervention_count" widget="statinfo" string="Interventions"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
